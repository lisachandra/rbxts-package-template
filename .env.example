# Optional: Roblox Open Cloud credentials, only for the release workflow's
# Open Cloud lane. The default test lane is offline (emulator backend), so CI and
# local `pnpm test` need none of these.
#
# Create an API key against the target universe with the scopes:
#   universe-places:write
#   universe.place.luau-execution-session:write
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
