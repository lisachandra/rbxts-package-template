{
	"name": "@lisachandra/example",
	"version": "0.1.0",
	"private": false,
	"description": "Example package for the rbxts-package-template monorepo.",
	"keywords": [
		"example",
		"rbxts",
		"roblox"
	],
	"homepage": "https://github.com/lisachandra/rbxts-package-template",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts-package-template/issues"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"repository": {
		"type": "git",
		"url": "https://github.com/lisachandra/rbxts-package-template"
	},
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build .jest-roblox",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/types": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/types": "catalog:",
		"shx": "catalog:",
		"typescript": "catalog:"
	}
}
